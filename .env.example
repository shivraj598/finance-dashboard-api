# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Generate a strong secret key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────
# LOCAL development: SQLite (default, zero setup — just leave this as-is).
# The app resolves it to backend/taskr.db no matter where uvicorn is launched from.
DATABASE_URL=sqlite:///./taskr.db

# PRODUCTION: comment the line above and uncomment one below.
# DATABASE_URL=postgresql://user:password@localhost:5432/finance
# Render / Heroku style URLs (postgres://) are auto-converted.
# DATABASE_URL=postgres://user:password@host:5432/finance

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
